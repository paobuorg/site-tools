---
import type { Locale } from '@paobu/core/lib/i18n';
import Icon from '@paobu/core/components/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy = locale === 'zh-CN'
  ? {
      title: '生成赛前清单',
      intro: '按路面、时长和天气组合检查项。赛事强制装备仍然优先。',
      raceType: '比赛类型',
      road: '公路',
      trail: '越野',
      duration: '预计时长',
      under3: '少于 3 小时',
      between3and6: '3–6 小时',
      over6: '超过 6 小时',
      weather: '天气',
      mild: '温和',
      hot: '高温高湿',
      cold: '寒冷',
      rain: '下雨',
      travel: '异地参赛',
      submit: '生成清单',
      print: '打印清单',
      note: '这是准备提示，不是赛事规则。新装备、新补给和新药物不要第一次在比赛日使用。',
    }
  : {
      title: 'Generate a race checklist',
      intro: 'Combine surface, duration and weather to review items. The organiser’s mandatory kit takes precedence.',
      raceType: 'Race type',
      road: 'Road',
      trail: 'Trail',
      duration: 'Expected duration',
      under3: 'Under 3 hours',
      between3and6: '3–6 hours',
      over6: 'Over 6 hours',
      weather: 'Weather',
      mild: 'Mild',
      hot: 'Hot and humid',
      cold: 'Cold',
      rain: 'Rain',
      travel: 'Travelling to the race',
      submit: 'Generate checklist',
      print: 'Print checklist',
      note: 'This is a preparation prompt, not a race rulebook. Do not use new gear, fuel or medication for the first time on race day.',
    };
---

<div class="checklist-tool" data-race-checklist data-locale={locale}>
  <h2>{copy.title}</h2>
  <p class="checklist-intro">{copy.intro}</p>
  <form class="checklist-form" data-checklist-form>
    <div class="field">
      <label for="checklist-type">{copy.raceType}</label>
      <select id="checklist-type" name="raceType">
        <option value="road">{copy.road}</option>
        <option value="trail">{copy.trail}</option>
      </select>
    </div>
    <div class="field">
      <label for="checklist-duration">{copy.duration}</label>
      <select id="checklist-duration" name="duration">
        <option value="under-3h">{copy.under3}</option>
        <option value="3-6h">{copy.between3and6}</option>
        <option value="over-6h">{copy.over6}</option>
      </select>
    </div>
    <div class="field">
      <label for="checklist-weather">{copy.weather}</label>
      <select id="checklist-weather" name="weather">
        <option value="mild">{copy.mild}</option>
        <option value="hot">{copy.hot}</option>
        <option value="cold">{copy.cold}</option>
        <option value="rain">{copy.rain}</option>
      </select>
    </div>
    <label class="checklist-travel"><input type="checkbox" name="travel" />{copy.travel}</label>
    <div class="checklist-actions">
      <button class="button primary" type="submit"><Icon name="check" size={17} />{copy.submit}</button>
      <button class="button ghost" type="button" data-checklist-print><Icon name="file" size={17} />{copy.print}</button>
    </div>
  </form>
  <div class="checklist-result" data-checklist-result hidden></div>
  <p class="checklist-note">{copy.note}</p>
</div>

<style>
  .checklist-tool { display: grid; gap: 16px; }
  .checklist-tool h2 { margin: 0; font-size: 1.25rem; }
  .checklist-intro { margin: 0; color: var(--muted); line-height: 1.65; }
  .checklist-form { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; align-items: end; }
  .checklist-form .field { display: grid; gap: 5px; }
  .checklist-form label { font-weight: 700; font-size: .86rem; }
  .checklist-form select { width: 100%; }
  .checklist-travel { display: flex; align-items: center; gap: 7px; min-height: 42px; font-weight: 600; }
  .checklist-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 10px; }
  .checklist-result { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; border-top: 1px solid var(--border); padding-top: 16px; }
  .checklist-section { padding: 14px; border: 1px solid var(--border); border-radius: 14px; break-inside: avoid; }
  .checklist-section h3 { margin: 0 0 8px; font-size: .95rem; }
  .checklist-section ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 7px; }
  .checklist-section label { display: grid; grid-template-columns: auto 1fr; gap: 7px; align-items: start; font-size: .9rem; line-height: 1.45; }
  .checklist-section input { margin-top: 3px; }
  .checklist-section small { grid-column: 2; color: var(--muted); font-size: .8rem; }
  .checklist-note { margin: 0; color: var(--muted); font-size: .84rem; line-height: 1.6; }
  @media (max-width: 820px) { .checklist-form { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .checklist-form, .checklist-result { grid-template-columns: 1fr; } }
  @media print {
    .checklist-form, .checklist-actions, .checklist-note, .site-header, .site-footer, .bottom-nav, .breadcrumbs { display: none !important; }
    .checklist-result { display: block; }
    .checklist-section { margin-bottom: 10px; break-inside: avoid; }
  }
</style>
