---
import BaseLayout from '@paobu/core/layouts/BaseLayout.astro';
import Icon from '@paobu/core/components/Icon.astro';
import { t } from '@paobu/core/lib/i18n';
const locale = 'zh-CN' as const;
---
<BaseLayout
  locale={locale}
  title={t(locale, 'notFound')}
  description={t(locale, 'notFoundBody')}
  active="tools"
  noindex
>
  <div class="page-shell narrow">
    <div class="empty-state">
      <Icon name="tools" size={46} />
      <h2>{t(locale, 'notFound')}</h2>
      <p>{t(locale, 'notFoundBody')}</p>
      <a class="button primary" href="/zh-CN/">{t(locale, 'backHome')}</a>
      <a class="button ghost" href="/en/" hreflang="en" lang="en">English</a>
    </div>
  </div>
</BaseLayout>
