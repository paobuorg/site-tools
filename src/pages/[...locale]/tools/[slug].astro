export function getStaticPaths() {
  const content = siteContent();
  return LOCALES.flatMap((locale) =>
    content.visible('tool').map((entity) => ({
      params: { locale: localeStaticParam(locale), slug: entity.slug },
      props: { entityId: entity.entityId, locale },
    })),
  );
}

const locale = Astro.props.locale as Locale;
const prefix = localePrefix(locale);
const content = siteContent();
const entity = content.byId(Astro.props.entityId);
if (!entity) throw new Error(`Tool ${Astro.props.entityId} is not visible`);
const translation = content.translation(entity, locale);
const details = toolDetails(entity);
const sources = content.sourcesFor(entity);
const related = content.related(entity, locale);
const cases = content.cases.filter((item) => item.toolId === entity.entityId);
const reviews = content.reviews.filter(
  (review) => review.entityId === entity.entityId && review.locale === locale,
);
const authors = [
  ...new Set(
    entity.translations
      .flatMap((item) => item.authors)
      .map((id) => content.contributors.find((person) => person.contributorId === id)?.displayName ?? id),
  ),
];
const other = otherLocale(locale);
const activeTool = [
  'pace',
  'splits',
  'run-walk',
  'race-predict',
  'track-view',
  'track-convert',
  'track-simplify',
  'route-compare',
  'fueling-planner',
  'route-elevation',
  'shoe-mileage',
  'race-checklist',
].includes(entity.slug);
const publishedRoutes = content.allEntities
  .filter((item) => item.kind === 'route' && item.status === 'published')
  .map((item) => {
    const route = item.details as RouteDetails;
    return {
      id: item.entityId,
      label: content.translation(item, locale).title,
      version: route.courseVersion,
      raceType: route.raceType,
      distanceMeters: route.distanceMeters,
      distanceMethod: route.distanceMethod,
      elevationGainMeters: route.elevationGainMeters,
      elevationMethod: route.elevationMethod,
      surface: route.surface ?? null,
      technicality: route.technicality ?? null,
      geometryAccess: route.geometryAccess,
      geometryUrl: route.officialGeometryUrl,
