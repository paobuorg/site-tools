  rwRun: locale === 'zh-CN' ? '跑步' : 'Run',
  rwWalk: locale === 'zh-CN' ? '步行' : 'Walk',
  rwFull: locale === 'zh-CN' ? '完整' : 'Complete',
  rwPartial: locale === 'zh-CN' ? '不完整' : 'Partial',
  raceDistanceError: locale === 'zh-CN' ? '距离需在 5 至 42.195 公里之间（或等值英里）。' : 'Distance must be between 5 km and 42.195 km (or the equivalent in miles).',
  raceTimeError: locale === 'zh-CN' ? '请输入大于零的完赛时间，例如 00:50:00。' : 'Enter a finish time greater than zero, for example 00:50:00.',
  simplifyToleranceError: locale === 'zh-CN' ? '简化容差必须在 1 到 100 米之间。' : 'Simplification tolerance must be between 1 and 100 metres.',
  simplifyLatitudeError: locale === 'zh-CN' ? '第 {segment} 段包含纬度超过 85 度的点，首版拒绝简化。' : 'Segment {segment} contains a point beyond 85 degrees latitude; this version cannot simplify it.',
  simplifyDatelineError: locale === 'zh-CN' ? '第 {segment} 段跨越日界线，首版拒绝简化。' : 'Segment {segment} crosses the antimeridian; this version cannot simplify it.',
  simplifyRangeError: locale === 'zh-CN' ? '第 {segment} 段范围超过 500 公里，首版拒绝简化。' : 'Segment {segment} spans more than 500 km; this version cannot simplify it.',
  slowHint: locale === 'zh-CN' ? '文件仍在本地处理。你可以取消后尝试更小的文件。' : 'The file is still being processed locally. You can cancel and try a smaller file.',
  routeField: locale === 'zh-CN' ? '字段' : 'Field',
  routeDistance: locale === 'zh-CN' ? '距离' : 'Distance',
  routeElevation: locale === 'zh-CN' ? '高程爬升' : 'Elevation gain',
  routeSurface: locale === 'zh-CN' ? '路面' : 'Surface',
  routeTechnicality: locale === 'zh-CN' ? '技术性' : 'Technicality',
  routeUnknown: locale === 'zh-CN' ? '未知' : 'Unknown',
  routeVersion: locale === 'zh-CN' ? '版本' : 'Version',
  routeOfficialGeometry: locale === 'zh-CN' ? '官方轨迹' : 'Official track',
  routeTypeRoad: locale === 'zh-CN' ? '公路马拉松' : 'Road marathon',
  routeTypeTrail: locale === 'zh-CN' ? '越野超马' : 'Trail ultramarathon',
  routeGeometryRedistributable: locale === 'zh-CN' ? '可再分发' : 'Redistributable',
  routeGeometryOfficial: locale === 'zh-CN' ? '官方链接' : 'Official link',
  routeGeometryUnavailable: locale === 'zh-CN' ? '无公开几何' : 'No public geometry',
  routeErrorCount: locale === 'zh-CN' ? '请选择 2 至 4 个已发布赛道版本。' : 'Choose 2 to 4 published route versions.',
  ready: locale === 'zh-CN' ? '请选择文件。' : 'Choose a file.',
  processing: locale === 'zh-CN' ? '正在本地读取文件…' : 'Reading the file locally…',
  done: locale === 'zh-CN' ? '完成。' : 'Done.',
  cancelled: locale === 'zh-CN' ? '已取消。' : 'Cancelled.',
  timeout: locale === 'zh-CN' ? '处理超时，请尝试更小的文件。' : 'Processing took too long. Try a smaller file.',
  tooLarge: locale === 'zh-CN' ? `文件超过 ${Math.round(MAX_FILE_BYTES / 1_000_000)} MB，已拒绝。` : `The file exceeds ${Math.round(MAX_FILE_BYTES / 1_000_000)} MB and was rejected.`,
  unsafeXml: locale === 'zh-CN' ? '文件包含 DTD 或实体声明，出于安全原因已拒绝。' : 'The file contains a DTD or entity declaration and was rejected for safety.',
  invalidXml: locale === 'zh-CN' ? 'GPX 文件不是格式正确的 XML。' : 'The GPX file is not well-formed XML.',
  unsupported: locale === 'zh-CN' ? '只支持 GPX 与 GeoJSON 文件。' : 'Only GPX and GeoJSON files are supported.',
  invalidJson: locale === 'zh-CN' ? 'GeoJSON 文件不是有效 JSON。' : 'The GeoJSON file is not valid JSON.',
  noPoints: locale === 'zh-CN' ? '文件没有可读取的轨迹点。' : 'No track points were found.',
  invalidCoordinate: locale === 'zh-CN' ? '文件包含无效的经纬度。' : 'The file contains an invalid coordinate.',
  tooManyPoints: locale === 'zh-CN' ? '坐标点超过上限。' : 'The file contains too many points.',
  emptyGeometry: locale === 'zh-CN' ? '文件没有可用的线几何。' : 'The file contains no usable line geometry.',
  unknownError: locale === 'zh-CN' ? '无法读取这个文件。' : 'The file could not be read.',
  failed: locale === 'zh-CN' ? '处理失败，请检查文件。' : 'Processing failed. Check the file.',
  unknown: locale === 'zh-CN' ? '未知' : 'Unknown',
  elevationMissing: locale === 'zh-CN' ? '文件没有高程数据；累计爬升显示为未知。' : 'The file has no elevation values; gain is unknown.',
  elevationPartial: locale === 'zh-CN' ? '部分点缺少高程；为避免低估，累计爬升显示为未知。' : 'Some points lack elevation; gain is unknown to avoid undercounting.',
  suspiciousJumps: locale === 'zh-CN' ? '发现 {count} 处相邻点距离超过 10 公里，可能是断点或异常坐标。' : 'Found {count} point-to-point gaps over 10 km, likely breaks or bad coordinates.',
  multipleSegments: locale === 'zh-CN' ? '文件包含 {count} 个线段；距离分别累计，不把线段端点人为连接。' : 'The file contains {count} segments; distances are summed without joining their endpoints.',
};
const title = `${translation.title} · RunMap`;
const pageOrigin = Astro.site ?? Astro.url.origin;
const pageUrl = new URL(`${prefix}/tools/${entity.slug}/`, pageOrigin).toString();
const structuredData = [
  breadcrumbList([
    { name: copy.home, url: new URL(`${prefix}/`, pageOrigin).toString() },
    { name: copy.tools, url: new URL(`${prefix}/`, pageOrigin).toString() },
    { name: translation.title, url: pageUrl },
  ]),
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={translation.summary}
  active="tools"
  preview={content.preview}
  ogType="article"
  alternateHref={`${localePrefix(other)}/tools/${entity.slug}/`}
  structuredData={structuredData}
>
  <div class="page-shell">
    <div class="breadcrumbs">
      <ol>
        <li><a href={`${prefix}/`}>{copy.home}</a></li>
        <li><a href={`${prefix}/`}>{copy.tools}</a></li>
        <li>{translation.title}</li>
      </ol>
    </div>

    <header class="tool-header">
      <span class="tool-header-icon" aria-hidden="true"><Icon name={toolIcon(entity.slug)} size={30} /></span>
      <div class="tool-header-copy">
        <div class="tool-tags">
          <span class="pill">{details.specVersion}</span>
          <span class="pill mint"><Icon name="shield" size={13} />{copy.privacy}</span>
          {entity.status !== 'published' && <span class="pill coral">{copy.preview}</span>}
        </div>
        <h1>{translation.title}</h1>
        <p>{translation.summary}</p>
      </div>
    </header>

    {entity.status !== 'published' && (
      <div class="notice tone-yellow">
        <Icon name="alert" size={18} />
        <div>
          <strong>{copy.preview}</strong>
          <p>{copy.previewNote}</p>
        </div>
      </div>
    )}

    <div class="tool-layout">
      <div
        class="card tool-calc"
        data-tool={entity.slug}
        data-locale={locale}
        data-strings={JSON.stringify(clientStrings)}
        data-routes={JSON.stringify(publishedRoutes)}
        data-max-file-bytes={MAX_FILE_BYTES}
      >
        {entity.slug === 'pace' && (
          <>
            <h2>{copy.paceFormTitle}</h2>
            <form class="calc-form" data-pace-form novalidate>
              <fieldset class="field unit-field">
                <legend>{copy.paceMode}</legend>
                <div class="segmented mode-segmented">
                  <label><input type="radio" name="pace-mode" value="distance-time" checked /><span>{copy.modeDistanceTime}</span></label>
                  <label><input type="radio" name="pace-mode" value="distance-pace" /><span>{copy.modeDistancePace}</span></label>
                  <label><input type="radio" name="pace-mode" value="time-pace" /><span>{copy.modeTimePace}</span></label>
                </div>
              </fieldset>
              <div class="field" data-mode-field="distance">
                <label for="pace-distance">{copy.distance}</label>
                <input id="pace-distance" data-distance type="number" min="0.001" step="any" value="10" inputmode="decimal" />
                <p class="field-error" data-error="distance" hidden></p>
              </div>
              <fieldset class="field unit-field">
                <legend>{copy.unit}</legend>
                <div class="segmented">
                  <label><input type="radio" name="unit" value="km" checked /><span>{copy.km}</span></label>
                  <label><input type="radio" name="unit" value="mi" /><span>{copy.mi}</span></label>
                </div>
              </fieldset>
              <div class="field" data-mode-field="duration">
                <label for="pace-duration">{copy.duration}</label>
                <input id="pace-duration" data-duration type="text" value="00:50:00" inputmode="numeric" autocomplete="off" aria-describedby="pace-duration-hint" />
                <p class="field-hint" id="pace-duration-hint">{copy.durationHint}</p>
                <p class="field-error" data-error="duration" hidden></p>
              </div>
              <div class="field" data-mode-field="pace" hidden>
                <label for="pace-value">{copy.pace}</label>
                <input id="pace-value" data-pace-value type="text" value="05:00" inputmode="numeric" autocomplete="off" aria-describedby="pace-value-hint" />
                <p class="field-hint" id="pace-value-hint">{copy.paceHint}</p>
                <p class="field-error" data-error="pace" hidden></p>
              </div>
              <button class="button primary wide" type="submit"><Icon name="timer" size={18} />{copy.calculate}</button>
            </form>

            <div class="calc-result" data-pace-result hidden>
              <h2>{copy.paceResultTitle}</h2>
              <span class="field-hint">{copy.averagePace}</span>
              <div class="result-hero">
                <strong data-pace-km>—</strong><span>/km</span>
              </div>
              <dl class="result-grid">
                <div>
                  <dt>{copy.paceMile}</dt>
                  <dd><span data-pace-mi>—</span> /mi</dd>
                </div>
                <div>
                  <dt>{copy.averageSpeed}</dt>
                  <dd><span data-pace-speed>—</span> {copy.speedUnit}</dd>
                </div>
                <div>
                  <dt>{copy.totalTime}</dt>
                  <dd data-pace-duration>—</dd>
                </div>
                <div>
                  <dt>{copy.distance}</dt>
                  <dd data-distance-used>—</dd>
                </div>
              </dl>
              <p class="result-note">{copy.paceNote}</p>
              <a class="button ghost wide" data-splits-link href={`${prefix}/tools/splits/`}>
                <Icon name="list" size={17} />{copy.makeSplits}
              </a>
            </div>
          </>
        )}

        {entity.slug === 'splits' && (
          <>
            <h2>{copy.splitsFormTitle}</h2>
            <form class="calc-form" data-splits-form novalidate>
              <div class="field">
                <label for="splits-distance">{copy.totalDistance}</label>
                <input id="splits-distance" data-distance type="number" min="0.001" step="any" value="42.195" inputmode="decimal" />
                <p class="field-error" data-error="distance" hidden></p>
              </div>
              <fieldset class="field unit-field">
                <legend>{copy.unit}</legend>
                <div class="segmented">
                  <label><input type="radio" name="unit" value="km" checked /><span>{copy.km}</span></label>
                  <label><input type="radio" name="unit" value="mi" /><span>{copy.mi}</span></label>
                </div>
              </fieldset>
              <div class="field">
                <label for="splits-duration">{copy.duration}</label>
                <input id="splits-duration" data-duration type="text" value="03:30:00" inputmode="numeric" autocomplete="off" aria-describedby="splits-duration-hint" />
                <p class="field-hint" id="splits-duration-hint">{copy.durationHint}</p>
                <p class="field-error" data-error="duration" hidden></p>
              </div>
              <div class="field">
                <label for="splits-split">{copy.splitDistance}</label>
                <input id="splits-split" data-split-distance type="number" min="0.001" step="any" value="5" inputmode="decimal" />
                <p class="field-error" data-error="split" hidden></p>
              </div>
              <fieldset class="field unit-field">
                <legend>{copy.splitStrategy}</legend>
                <div class="segmented">
                  <label><input type="radio" name="split-strategy" value="even" checked /><span>{copy.strategyEven}</span></label>
                  <label><input type="radio" name="split-strategy" value="negative" /><span>{copy.strategyNegative}</span></label>
                </div>
              </fieldset>
              <div class="field" data-split-delta-field hidden>
                <label for="splits-delta">{copy.delta}</label>
                <input id="splits-delta" data-split-delta type="number" min="0" max="0.1" step="0.01" value="0.02" inputmode="decimal" aria-describedby="splits-delta-hint" />
                <p class="field-hint" id="splits-delta-hint">{copy.deltaHint}</p>
                <p class="field-error" data-error="delta" hidden></p>
              </div>
              <button class="button primary wide" type="submit"><Icon name="list" size={18} />{copy.calculate}</button>
            </form>

            <div class="calc-result" data-splits-result hidden>
              <div class="result-heading">
                <h2>{copy.splitsResultTitle}</h2>
                <button class="button small ghost" type="button" data-print-splits>{copy.print}</button>
              </div>
              <p class="field-hint" data-splits-summary></p>
              <div class="split-table-wrap">
                <table class="split-table">
                  <thead>
                    <tr>
                      <th scope="col">{copy.tableIndex}</th>
                      <th scope="col">{copy.tableDistance}</th>
                      <th scope="col">{copy.tableCumulative}</th>
                      <th scope="col">{copy.tableSplit}</th>
                    </tr>
                  </thead>
                  <tbody data-splits-body></tbody>
                </table>
              </div>
              <p class="result-note">{copy.splitNote}</p>
            </div>
          </>
        )}

        {entity.slug === 'run-walk' && (
          <>
            <h2>{copy.runWalkFormTitle}</h2>
            <form class="calc-form" data-run-walk-form novalidate>
              <fieldset class="field unit-field">
                <legend>{copy.runWalkMode}</legend>
                <div class="segmented mode-segmented">
                  <label><input type="radio" name="run-walk-mode" value="cycles" checked /><span>{copy.rwModeCycles}</span></label>
                  <label><input type="radio" name="run-walk-mode" value="duration" /><span>{copy.rwModeDuration}</span></label>
                </div>
              </fieldset>
              <div class="field">
                <label for="rw-run">{copy.runDuration}</label>
                <input id="rw-run" data-run-duration type="text" value="02:00" inputmode="numeric" autocomplete="off" aria-describedby="rw-run-hint" />
                <p class="field-hint" id="rw-run-hint">{copy.runDurationHint}</p>
                <p class="field-error" data-error="run" hidden></p>
              </div>
              <div class="field">
                <label for="rw-walk">{copy.walkDuration}</label>
                <input id="rw-walk" data-walk-duration type="text" value="01:00" inputmode="numeric" autocomplete="off" aria-describedby="rw-walk-hint" />
                <p class="field-hint" id="rw-walk-hint">{copy.walkDurationHint}</p>
                <p class="field-error" data-error="walk" hidden></p>
              </div>
              <div class="field" data-run-walk-field="cycles">
                <label for="rw-cycles">{copy.cyclesLabel}</label>
                <input id="rw-cycles" data-cycles type="number" min="1" max="1000" step="1" value="8" inputmode="numeric" aria-describedby="rw-cycles-hint" />
                <p class="field-hint" id="rw-cycles-hint">{copy.cyclesHint}</p>
                <p class="field-error" data-error="cycles" hidden></p>
              </div>
              <div class="field" data-run-walk-field="duration" hidden>
                <label for="rw-total">{copy.totalDuration}</label>
                <input id="rw-total" data-total-duration type="text" value="00:30:00" inputmode="numeric" autocomplete="off" aria-describedby="rw-total-hint" />
                <p class="field-hint" id="rw-total-hint">{copy.totalDurationHint}</p>
                <p class="field-error" data-error="total" hidden></p>
              </div>
              <button class="button primary wide" type="submit"><Icon name="motion" size={18} />{copy.calculate}</button>
            </form>

            <div class="calc-result" data-run-walk-result hidden>
              <h2>{copy.runWalkResultTitle}</h2>
              <span class="field-hint">{copy.rwScheduled}</span>
              <div class="result-hero">
                <strong data-rw-scheduled>—</strong>
              </div>
              <dl class="result-grid">
                <div>
                  <dt>{copy.rwRunTotal}</dt>
                  <dd data-rw-run>—</dd>
                </div>
                <div>
                  <dt>{copy.rwWalkTotal}</dt>
                  <dd data-rw-walk>—</dd>
                </div>
                <div>
                  <dt>{copy.rwFullCycles}</dt>
                  <dd data-rw-cycles>—</dd>
                </div>
                <div>
                  <dt>{copy.rwRequested}</dt>
                  <dd data-rw-requested>—</dd>
                </div>
              </dl>
              <p class="result-note" data-rw-status></p>
              <div class="split-table-wrap">
                <table class="split-table">
                  <thead>
                    <tr>
                      <th scope="col">{copy.rwTableCycle}</th>
                      <th scope="col">{copy.rwTableKind}</th>
                      <th scope="col">{copy.rwTableDuration}</th>
                      <th scope="col">{copy.rwTableStatus}</th>
                    </tr>
                  </thead>
                  <tbody data-rw-body></tbody>
                </table>
              </div>
              <p class="result-note">{copy.rwNote}</p>
            </div>
          </>
        )}

        {entity.slug === 'race-predict' && (
          <>
            <h2>{copy.raceFormTitle}</h2>
            <form class="calc-form" data-race-form novalidate>
              <fieldset class="field unit-field">
                <legend>{copy.unit}</legend>
                <div class="segmented">
                  <label><input type="radio" name="unit" value="km" checked /><span>{copy.km}</span></label>
                  <label><input type="radio" name="unit" value="mi" /><span>{copy.mi}</span></label>
                </div>
              </fieldset>
              <div class="field">
                <label for="race-known-distance">{copy.knownDistance}</label>
                <input id="race-known-distance" data-known-distance type="number" min="0.001" step="any" value="10" inputmode="decimal" aria-describedby="race-distance-hint" />
                <p class="field-hint" id="race-distance-hint">{copy.raceDistanceHint}</p>
                <p class="field-error" data-error="knownDistance" hidden></p>
              </div>
              <div class="field">
                <label for="race-known-time">{copy.knownTime}</label>
                <input id="race-known-time" data-known-time type="text" value="00:50:00" inputmode="numeric" autocomplete="off" aria-describedby="race-time-hint" />
                <p class="field-hint" id="race-time-hint">{copy.raceTimeHint}</p>
                <p class="field-error" data-error="knownTime" hidden></p>
              </div>
              <div class="field">
                <label for="race-target-distance">{copy.targetDistance}</label>
                <input id="race-target-distance" data-target-distance type="number" min="0.001" step="any" value="21.0975" inputmode="decimal" />
                <p class="field-error" data-error="targetDistance" hidden></p>
              </div>
              <button class="button primary wide" type="submit"><Icon name="chart" size={18} />{copy.calculate}</button>
            </form>

            <div class="calc-result" data-race-result hidden>
              <h2>{copy.raceResultTitle}</h2>
              <span class="field-hint">{copy.racePredictedTime}</span>
              <div class="result-hero">
                <strong data-race-time>—</strong>
              </div>
              <dl class="result-grid">
                <div>
                  <dt>{copy.averagePace}</dt>
                  <dd><span data-race-pace-km>—</span> /km</dd>
                </div>
                <div>
                  <dt>{copy.paceMile}</dt>
                  <dd><span data-race-pace-mi>—</span> /mi</dd>
                </div>
                <div>
                  <dt>{copy.averageSpeed}</dt>
                  <dd><span data-race-speed>—</span> {copy.speedUnit}</dd>
                </div>
                <div>
                  <dt>{copy.raceRatio}</dt>
                  <dd data-race-ratio>—</dd>
                </div>
              </dl>
              <p class="result-note">{copy.racePaceNote}</p>
            </div>
          </>
        )}

        {entity.slug === 'track-convert' && (
          <>
            <h2>{copy.convertFormTitle}</h2>
            <div class="track-form">
              <div class="field">
                <label for="convert-file">{copy.trackFile}</label>
                <input id="convert-file" data-transform-file type="file" accept=".gpx,.geojson,.json,application/gpx+xml,application/geo+json" />
                <p class="field-hint">{copy.trackFileHint}</p>
                <p class="field-hint track-privacy"><Icon name="shield" size={14} />{copy.convertPrivacy}</p>
              </div>
              <fieldset class="field unit-field">
                <legend>{copy.convertFormat}</legend>
                <div class="segmented">
                  <label><input type="radio" name="convert-format" value="gpx" /><span>GPX</span></label>
                  <label><input type="radio" name="convert-format" value="geojson" checked /><span>GeoJSON</span></label>
                </div>
                <p class="field-hint">{copy.convertFormatHint}</p>
              </fieldset>
              <div class="track-actions">
                <button class="button primary" type="button" data-transform-run disabled><Icon name="code" size={18} />{copy.convertStart}</button>
                <button class="button ghost" type="button" data-transform-cancel hidden>{copy.trackCancel}</button>
              </div>
              <p class="track-status" role="status" aria-live="polite" data-transform-status></p>
              <progress data-transform-progress max="1" value="0" hidden></progress>
              <div class="track-error" data-transform-error hidden>
                <Icon name="alert" size={18} />
                <p data-transform-error-text></p>
              </div>
            </div>

            <div class="calc-result" data-convert-result hidden>
              <div class="result-heading">
                <h2>{copy.convertResultTitle}</h2>
                <span class="pill" data-convert-file-name></span>
              </div>
              <dl class="result-grid track-stats">
                <div>
                  <dt>{copy.convertSourceFormat}</dt>
                  <dd data-convert-source>—</dd>
                </div>
                <div>
                  <dt>{copy.convertOutputFormat}</dt>
                  <dd data-convert-format>—</dd>
                </div>
                <div>
                  <dt>{copy.trackPoints}</dt>
                  <dd data-convert-points>—</dd>
                </div>
                <div>
                  <dt>{copy.trackSegments}</dt>
                  <dd data-convert-segments>—</dd>
                </div>
                <div>
                  <dt>{copy.trackDistance}</dt>
                  <dd data-convert-distance>—</dd>
                </div>
                <div>
                  <dt>{copy.convertOutputBytes}</dt>
                  <dd data-convert-size>—</dd>
                </div>
              </dl>
              <a class="button primary wide track-download" data-convert-download href="#" download hidden>
                <Icon name="download" size={18} />{copy.convertDownload}
              </a>
              <p class="result-note">{copy.convertNote}</p>
            </div>
          </>
        )}

        {entity.slug === 'track-simplify' && (
          <>
            <h2>{copy.simplifyFormTitle}</h2>
            <div class="track-form">
              <div class="field">
                <label for="simplify-file">{copy.trackFile}</label>
                <input id="simplify-file" data-transform-file type="file" accept=".gpx,.geojson,.json,application/gpx+xml,application/geo+json" />
                <p class="field-hint">{copy.trackFileHint}</p>
                <p class="field-hint track-privacy"><Icon name="shield" size={14} />{copy.convertPrivacy}</p>
              </div>
              <div class="field">
                <label for="simplify-tolerance">{copy.simplifyTolerance}</label>
                <input id="simplify-tolerance" data-simplify-tolerance type="number" min="1" max="100" step="1" value="10" inputmode="numeric" aria-describedby="simplify-tolerance-hint" />
