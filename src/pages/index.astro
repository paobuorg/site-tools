---
const title = '跑地图工具 · RunMap Tools';
const description = '选择语言进入跑地图工具站：中文或 English。';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://tools.paobu.org/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root { color-scheme: light; }
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        background: radial-gradient(circle at 60% 30%, #154c58, #06101f 62%);
        color: #eef7f5;
        font-family: system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
      }
      main { width: min(92vw, 520px); padding: 32px; text-align: center; }
      .mark {
        width: 74px; height: 74px; margin: 0 auto 22px; border-radius: 24px;
        display: grid; place-items: center;
        background: #08b89d; color: #062c29; font-size: 1.6rem; font-weight: 900;
      }
      h1 { margin: 0 0 8px; font-size: 1.6rem; }
      p { margin: 0 0 24px; color: #b9d3d0; line-height: 1.7; }
      .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
      a {
        display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px;
        border-radius: 999px; background: #08b89d; color: #062c29;
        font-weight: 800; text-decoration: none;
      }
      a.secondary { background: rgba(255,255,255,0.12); color: #eef7f5; }
    </style>
    <script is:inline>
      (function () {
        function readCookie(name) {
          var prefix = name + '=';
          var parts = document.cookie ? document.cookie.split('; ') : [];
          for (var i = 0; i < parts.length; i += 1) {
            if (parts[i].indexOf(prefix) === 0) return decodeURIComponent(parts[i].slice(prefix.length));
          }
          return null;
        }
        var preference = null;
        try { preference = localStorage.getItem('paobu_locale'); } catch (error) {}
        preference = preference || readCookie('paobu_locale');
        if (preference !== 'zh-CN' && preference !== 'en') {
          var languages = navigator.languages || [navigator.language || 'zh-CN'];
          preference = String(languages[0] || '').toLowerCase().indexOf('zh') === 0 ? 'zh-CN' : 'en';
        }
        window.location.replace('/' + preference + '/');
      })();
    </script>
  </head>
  <body>
    <main>
      <div class="mark" aria-hidden="true">算</div>
      <h1>跑地图知识</h1>
      <p>可解释的跑步计算。<br />Explainable running calculators.</p>
      <div class="links">
        <a href="/zh-CN/">中文</a>
        <a class="secondary" href="/en/" hreflang="en" lang="en">English</a>
      </div>
    </main>
  </body>
</html>
